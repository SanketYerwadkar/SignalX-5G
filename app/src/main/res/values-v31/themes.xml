<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SignalX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sx_background</item>
        <item name="android:statusBarColor">@color/sx_background</item>
        <item name="android:navigationBarColor">@color/sx_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Android 12+ (API 31+) Splash Screen: remove system white launcher icon and match background -->
        <item name="android:windowSplashScreenBackground">@color/sx_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
    </style>
</resources>
